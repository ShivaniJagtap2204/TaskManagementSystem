@{
}


<div class="container mt-4">
    <h2>Notifications</h2>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>User</th>
                <th>Task</th>
                <th>Type</th>
                <th>Message</th>
                <th>Read</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.NotificationId</td>
                    <td>@n.UserId</td>
                    <td>@n.TaskId</td>
                    <td>@n.NotificationType</td>
                    <td>@n.Message</td>
                    <td>@n.IsRead</td>
                </tr>
            }
        </tbody>
    </table>
</div>