@{
}

@{
    ViewData["Title"] = "Users";
}
<a href="/Users/Create" class="btn btn-primary mb-3">
    Add User
</a>
<div class="container mt-4">

    <h2>Users</h2>

    <table class="table table-bordered table-striped mt-3">

        <thead>
            <tr>
                <th>User ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role ID</th>
                <th>Active</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.RoleId</td>
                    <td>@user.IsActive</td>
                </tr>
            }

        </tbody>

    </table>

</div>