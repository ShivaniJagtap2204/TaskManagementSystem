@{
}

@{
    ViewData["Title"] = "Tasks";
}

<div class="container mt-4">

    <h2>Tasks</h2>

    <a href="/Tasks/Create" class="btn btn-primary mb-3">
        Create Task
    </a>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Description</th>
                <th>Assigned To</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Deadline</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.TaskId</td>
                    <td>@task.Title</td>
                    <td>@task.Description</td>
                    <td>@task.AssignedTo</td>
                    <td>@task.Priority</td>
                    <td>@task.Status</td>
                    <td>@task.Deadline</td>

                    <td>
                        <a href="/Tasks/Edit/@task.TaskId"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a href="/Tasks/Delete/@task.TaskId"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this task?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>