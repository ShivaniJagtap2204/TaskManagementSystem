@{
}

@{
    ViewData["Title"] = "Teams";
}

<div class="container mt-4">

    <h2>Teams</h2>

    <table class="table table-bordered table-striped mt-3">

        <thead>
            <tr>
                <th>Team ID</th>
                <th>Team Name</th>
                <th>Manager ID</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var team in Model)
            {
                <tr>
                    <td>@team.TeamId</td>
                    <td>@team.TeamName</td>
                    <td>@team.ManagerId</td>
                </tr>
            }
        </tbody>

    </table>

</div>