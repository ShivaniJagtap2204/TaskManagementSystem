@{
}

@{
    ViewData["Title"] = "Team Members";
}

<div class="container mt-4">

    <h2>Team Members</h2>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>ID</th>
                <th>Team ID</th>
                <th>User ID</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var member in Model)
            {
                <tr>
                    <td>@member.TeamMemberId</td>
                    <td>@member.TeamId</td>
                    <td>@member.UserId</td>
                </tr>
            }

        </tbody>

    </table>

</div>